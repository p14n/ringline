#kaocha/v1
{:tests [{:id :unit
          :test-paths ["test"]
          :source-paths ["src"]
          :ns-patterns [".*-test$"]}
         {:id :example
          :test-paths ["example/test"]
          :source-paths ["src" "example/src"]
          :ns-patterns [".*-test$"]}]
 
 :plugins [:kaocha.plugin/randomize
           :kaocha.plugin/filter
           :kaocha.plugin/capture-output]
 
 :color? true
 :randomize? false
 :fail-fast? false
 :watch? false}

